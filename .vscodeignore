# Default deny: only the runtime files below belong in the VSIX.
# VSCE negations are unconditional includes, not ordered like Git rules.
# Do not add broad !node_modules/** or !resources/** rules.
**

# Extension manifest, usage information and license notices
!package.json
!README.MD
!CHANGELOG.md
!LICENSE
!THIRD_PARTY_NOTICES.md

# Current host output is flat. Add subdirectory rules if src/ is reorganized.
!out/*.js

# Single-file Webview and scene runtime resources
!webview-dist/index.html
!resources/wallpaper-scene.html
!resources/wallpaper-scene.js
!resources/wallpaper-studio.png
!resources/activity-bar.svg
!resources/light/home.svg
!resources/light/refresh.svg
!resources/dark/home.svg
!resources/dark/refresh.svg

# Runtime dependency closure for package-lock.json.
# Recheck this list and extracted-package loading whenever dependencies change.
!node_modules/@vscode/sudo-prompt/{index.js,package.json,LICENSE}
!node_modules/fs-extra/{package.json,LICENSE}
!node_modules/fs-extra/lib/**/*.js
!node_modules/proper-lockfile/{index.js,package.json,LICENSE}
!node_modules/proper-lockfile/lib/**/*.js
!node_modules/graceful-fs/{graceful-fs.js,polyfills.js,legacy-streams.js,clone.js,package.json,LICENSE}
!node_modules/jsonfile/{index.js,utils.js,package.json,LICENSE}
!node_modules/universalify/{index.js,package.json,LICENSE}
!node_modules/retry/{index.js,package.json,License}
!node_modules/retry/lib/*.js
!node_modules/signal-exit/{index.js,signals.js,package.json,LICENSE.txt}

# Scene renderer reads the browser bundle and resolves webwallgl/package.json.
# mediabunny is already bundled; ESM, types, images and examples are not loaded.
!node_modules/webwallgl/{webwallgl.global.min.js,package.json,LICENSE}
